local function GetCoin()
    local coins = {}
    
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        local humanoidRootPartPos = Player.Character.HumanoidRootPart.Position
        
        for _, model in pairs(Workspace:GetChildren()) do
            if model:IsA("Model") and model:FindFirstChild("CoinContainer") then
                for _, coin in pairs(model.CoinContainer:GetChildren()) do
                    if coin.Name == "Coin_Server" and not coin:FindFirstChild("CollectedCoin") and coin:FindFirstChild("TouchInterest") then
                        local distance = (humanoidRootPartPos - coin.Position).Magnitude
                        if distance < 100 then
                            table.insert(coins, {Coin = coin, Distance = distance})
                        end
                    end
                end
            end
        end
        
        table.sort(coins, function(a, b)
            return a.Distance < b.Distance
        end)
    end
    
    return coins[1] and coins[1].Coin
end
