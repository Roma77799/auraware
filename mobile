                    v.Icon.Image = guns[chosengun].Image
                end
            end
        end
    end)
    GunVisual = LocalPlayer.Backpack.DescendantAdded:Connect(function(arg)
        if tostring(arg) == "Gun" then
            task.wait()
            USABLEGUN = LocalPlayer.Backpack.Gun.Handle
