function CoinFarm3()
    full_bag = false
    if Config.CoinFarm3.State then
        PlayerToBrick()
    end
    while not full_bag do
        local Map = GetMap()
        if Map then
            if Config.CoinFarm3.State then
                task.spawn(function()
                    pcall(function()
                        DestroyMapFunc()
                    end)
                end)
                local lowestCoin = nil
                local lowestHeight = math.huge
                
                for _, v in ipairs(Map['CoinContainer']:GetChildren()) do
                    if v:FindFirstChild('TouchInterest') then
                        local coinHeight = v.Position.Y
                        if coinHeight < lowestHeight then
                            lowestHeight = coinHeight
                            lowestCoin = v
                        end
                    end
                end
                coin = lowestCoin
                local collected = false
                PlayerToCoin(coin)
                local connection
                connection = CoinCollected.OnClientEvent:Connect(function(name, rightnow, maximum, sometable)
                    collected = true
                    if rightnow == maximum then
                        full_bag = true
                    end
                end)
                if full_bag then
                    break
                end
                repeat
                    task.wait()
                    task.spawn(function()
                        firetouchinterest(plr.Character.HumanoidRootPart, coin, 0)
                        firetouchinterest(plr.Character.HumanoidRootPart, coin, 1)
                    end)
                    task.wait()
                    clipclop()
                    PlayerToCoin(coin)
                until collected or not coin:FindFirstChild('TouchInterest')
                connection:Disconnect()
                connection = nil
                PlayerToBrick()
                wait(CoinColldown)
            else
                break
            end
        else
            task.wait(1)
            if not Config.CoinFarm3.State then
                break
            end
        end
    end
end

