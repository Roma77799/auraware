function equipgun(chosengun)
    if __EQUIPPED == false then
        return
    end
    disconect()
    ch = LocalPlayer.Character
    repeat task.wait() until ch:FindFirstChild("HumanoidRootPart")
    repeat
        for i,v in pairs(workspace.WeaponDisplays:GetChildren()) do
            a = v.RigidConstraint.Attachment0
            b = v.RigidConstraint.Attachment0
